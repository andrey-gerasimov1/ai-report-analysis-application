# Server-side only. Never expose this value through NEXT_PUBLIC_*.
OPENAI_API_KEY=

# A smaller model keeps the demo responsive and economical.
OPENAI_MODEL=gpt-5-mini

# Optional independent model/timeout for metadata-only report routing.
OPENAI_ROUTER_MODEL=gpt-5-mini
OPENAI_ROUTER_TIMEOUT_MS=6000
# Set to false to force deterministic metadata routing.
OPENAI_ROUTING_ENABLED=true

# Required in production. Use a random value of at least 32 characters.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
